<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#15321F" />
            <stroke
                android:width="2dp"
                android:color="@color/fq_colorButtonNormal" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#204428" />
            <stroke
                android:width="1dp"
                android:color="#66FCAE40" />
        </shape>
    </item>
</layer-list>
